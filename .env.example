# =============================================================================
# Education ERP — local development environment.
# Copy to .env:   cp .env.example .env
# DUMMY VALUES ONLY. Never commit a real .env. Production secrets live in a secret manager.
# =============================================================================

# ---- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me-local-only-0000000000000000000000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,.localhost
# Host policy (Phase 3). PLATFORM_HOSTS: exact hosts that serve the platform ("api" is the
# compose service name the Next.js server uses). Every other host gets a uniform 404 unless
# TENANT_HOSTS_ENABLED=true, where {slug}.TENANT_BASE_DOMAIN is resolved to a tenant.
# Keep TENANT_HOSTS_ENABLED=false: production refuses "true" without a real base domain, and
# tenant hosts stay disabled until the domain and the security review are approved.
PLATFORM_HOSTS=localhost,127.0.0.1,api
TENANT_BASE_DOMAIN=localhost
TENANT_HOSTS_ENABLED=false
CSRF_TRUSTED_ORIGINS=http://localhost:8080
APP_ENVIRONMENT=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=console
API_DOCS_ENABLED=true

# ---- PostgreSQL (ADR-009 roles) --------------------------------------------
# Bootstrap superuser: used ONLY by the postgres container init script.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
ERP_DB_NAME=erp
ERP_OWNER_PASSWORD=erp_owner_dev_password
ERP_APP_PASSWORD=erp_app_dev_password
# Runtime role (NOSUPERUSER, NOBYPASSRLS):
DATABASE_URL=postgres://erp_app:erp_app_dev_password@postgres:5432/erp
# Owner role — migrations only:
DATABASE_MIGRATION_URL=postgres://erp_owner:erp_owner_dev_password@postgres:5432/erp

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Object storage (S3-compatible; SeaweedFS in dev — ADR-029) -------------
S3_ENDPOINT_URL=http://objectstore:8333
S3_BUCKET=erp-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=erp-dev-access-key
S3_SECRET_ACCESS_KEY=erp-dev-secret-key-change-me

# ---- Secrets at rest (ADR-031 / ADR-036) ----------------------------------
# Key ring "key_id:urlsafe-base64(32 bytes)"; first key encrypts, all decrypt. DUMMY dev keys:
# production refuses key ids starting with dev/test/example/change and loads real keys from a
# secret manager. Generate: python -c "from apps.core.crypto import generate_key; print(generate_key())"
FIELD_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktZmllbGQta2V5LW5vdC1hLXNlY3JldCE
IP_INDEX_KEY=aWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWk

# ---- Phase 2 security policy ----------------------------------------------
FRONTEND_BASE_URL=http://localhost:8080
MFA_ISSUER=Education ERP (dev)
SECURITY_IP_RETENTION_DAYS=365
# platform_staff | privileged | all | off
SECURITY_NOTIFY_NEW_SIGNIN=platform_staff
# Optional HIBP k-anonymity check (ADR-037 Q4); needs outbound access to api.pwnedpasswords.com
PASSWORD_BREACH_CHECK_ENABLED=false
PASSWORD_BREACH_CHECK_FAIL_CLOSED=false

# ---- Email (Mailpit captures everything in dev) -----------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@erp.localhost

# ---- Monitoring (optional) --------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Frontend ---------------------------------------------------------------
# Server-side (Next.js server components) API base URL on the internal network.
API_INTERNAL_URL=http://api:8000
NEXT_TELEMETRY_DISABLED=1

# ---- Host port for the single-origin Nginx entry point ----------------------
NGINX_PORT=8080
